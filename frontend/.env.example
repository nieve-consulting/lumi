# Development settings for the web app (pnpm dev). Copy to frontend/.env.local, which is gitignored. They point at the local
# proxy of pnpm start:local-dev on http://localhost:8080, which routes /graphql, /pdf, /agents and /mcp to the backend's
# development servers; https://docs.lumi.nieve.ai/getting-started is the guide. Never commit real credentials.

# The GraphQL API and PDF rendering, through the local proxy, and the shared secret: the same value as API_KEY in backend/.env
API_ENDPOINT=http://localhost:8080
API_KEY=local-development-api-key-0123456789

# The agents API: the browser calls it through the proxy on the app's own address; the server calls it directly
NEXT_PUBLIC_AGENTS_ENDPOINT=/agents
AGENTS_INTERNAL_ENDPOINT=http://localhost:4200/agents

# The app as browsers open it, through the local proxy
APP_BASE_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:8080

# Admin sign-in with email and password accounts. The same ADMIN_AUTH_PROVIDER as in backend/.env. NEXTAUTH_SECRET encrypts
# session cookies; LUMI_SETUP_TOKEN (at least 16 characters) completes the onboarding wizard, which creates the first admin
ADMIN_AUTH_PROVIDER=local
NEXTAUTH_SECRET=local-development-nextauth-secret
LUMI_SETUP_TOKEN=local-development-setup

# OpenAI API key for writing assistance in the admin interface
OPENAI_API_KEY=

# Optional: Langfuse tracing and links to sessions
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=
LANGFUSE_TRACING_ENVIRONMENT=development
