{
  "name": "lumi-widget",
  "version": "0.2.0",
  "description": "Embeddable widget for lumi",
  "type": "module",
  "main": "dist/lumi-widget.bundle.es.js",
  "types": "dist/widget.d.ts",
  "scripts": {
    "start": "webpack serve --config webpack/webpack.dev.ts",
    "build": "webpack --config webpack/prod/webpack.prod.es.ts && tsc -p tsconfig.typings.json",
    "build:umd": "webpack --config webpack/prod/webpack.prod.umd.ts",
    "build:full": "npm run build:umd && cp dist/*.bundle.umd.js dist/*.bundle.umd.js.LICENSE.txt ../frontend/public/scripts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src webpack",
    "format:check": "prettier --check src webpack"
  },
  "author": "Nieve Consulting",
  "license": "Apache-2.0",
  "dependencies": {
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/runtime": "^8.0.5",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  }
}
