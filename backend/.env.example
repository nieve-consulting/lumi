# Development settings for the backend servers (pnpm dev:apollo, dev:agents, dev:mcp, dev:tasks) and the db scripts. Copy to
# backend/.env, which is gitignored. They point at the local services of pnpm start:local-dev (local-dev/docker-local-env.yaml)
# and the proxy in front of them on http://localhost:8080; https://docs.lumi.nieve.ai/getting-started is the guide. Never
# commit real credentials.

# The local database
DB_HOST=localhost
DB_PORT=5432
DB_USER=devuser
DB_PASSWORD=devpassword
DB_NAME=lumi

# OpenAI API key for the assistant, knowledge search, website indexing and writing assistance
OPENAI_API_KEY=

# Shared secret between the web app and the backend, at least 32 characters. The same value as API_KEY in frontend/.env.local
API_KEY=local-development-api-key-0123456789

# The web app as browsers open it, through the local proxy
APP_BASE_URL=http://localhost:8080
AGENTS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Admin and MCP sign-in with email and password accounts stored by Lumi. The same value as in frontend/.env.local
ADMIN_AUTH_PROVIDER=local

# The MCP server as clients reach it, through the local proxy, and the secret that signs its tokens (at least 32 characters)
MCP_BASE_URL=http://localhost:8080
MCP_TOKEN_SECRET=local-development-mcp-token-secret-0123456789

# The local media storage. The backend and the web app's server reach it directly; browsers upload through the proxy
S3_UPLOADS_BUCKET_NAME=lumi-media
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8080
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=lumi
S3_SECRET_ACCESS_KEY=lumi-local-development-only

# Website crawls and PDF resumes run in the local tasks server (pnpm dev:tasks). PDFs need a Chromium headless shell, e.g.
# installed with: npx @puppeteer/browsers install chrome-headless-shell@stable --path ~/.cache/puppeteer (it prints the
# executable's path)
WEBSITE_CRAWLER_URL=http://localhost:4500
# On Linux, where the local proxy reaches the host on the Docker bridge, the address the tasks server listens on, e.g.
# 172.17.0.1. It then listens there only, so set WEBSITE_CRAWLER_URL to the same address too: http://172.17.0.1:4500
TASKS_HOST=
PUPPETEER_EXECUTABLE_PATH=

# Optional: in-chat Google Calendar booking. Empty keeps booking off
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# Optional: email delivery of enquiries and meeting emails, e.g. to a local mail catcher. Without EMAIL_FROM no email is sent
EMAIL_FROM=
SMTP_URL=

# Optional: Langfuse tracing, on only when both keys are set
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
