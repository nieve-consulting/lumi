{
  "name": "backend",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "db:migration:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:checkpointer:migrate": "tsx db/migrate-checkpointer.ts",
    "db:seed": "tsx db/seed.ts",
    "admin:reset": "tsx src/scripts/adminReset.ts",
    "build": "node build.mjs",
    "build:container": "node build-container.mjs",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "compile": "tsc",
    "start:apollo": "npm run build && node ./dist/bundle.js",
    "dev:apollo": "nodemon --ext ts --exec 'npm run build && node dist/bundle.js'",
    "dev:agents": "tsx watch src/ai/agents/local/server.ts",
    "dev:mcp": "tsx watch src/mcp/local/server.ts",
    "dev:tasks": "tsx watch src/tasks/local/server.ts",
    "codegen": "graphql-codegen-cjs --config codegen.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/langchain": "^3.0.166",
    "@apollo/server": "^5.5.1",
    "@as-integrations/aws-lambda": "^4.1.0",
    "@aws-sdk/client-lambda": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-secrets-manager": "^3.1164.0",
    "@aws-sdk/client-ses": "^3.1164.0",
    "@aws-sdk/client-sesv2": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@googleapis/calendar": "^20.1.0",
    "@graphql-tools/merge": "^9.2.8",
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/openai": "^1.8.2",
    "@langchain/pgvector": "^0.1.0",
    "@langfuse/langchain": "^5.14.0",
    "@langfuse/otel": "^5.14.0",
    "@langfuse/tracing": "^5.14.0",
    "@lumi/shared-contracts": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.1",
    "@opentelemetry/otlp-exporter-base": "^0.223.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@sparticuz/chromium": "153.0.0",
    "ai": "^7.0.166",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "graphql": "^16.15.0",
    "jose": "^6.2.16",
    "luxon": "^3.7.2",
    "minimatch": "^10.2.6",
    "nodemailer": "^10.4.0",
    "partial-json": "^0.1.7",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.17.0",
    "react": "^19.3.1",
    "react-email": "^6.11.8",
    "time-slots-finder": "^0.5.5",
    "turndown": "^7.2.5",
    "uuid": "^14.0.3",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/luxon": "^3.7.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@types/xml2js": "^0.4.14",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
