{
  "name": "lumi",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "start:local-dev": "docker compose -f ./local-dev/docker-local-env.yaml up",
