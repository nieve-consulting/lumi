# Lumi installation settings, read by deploy/compose.yaml. Copy to deploy/.env, fill in every required value and keep the
# file private: it holds the installation's credentials. Every value below is a placeholder.
#
# Generate each random value separately, for example with: openssl rand -hex 32
# https://docs.lumi.nieve.ai/self-hosting documents every setting.

# ---------------------------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------------------------

# Image tag of the Lumi version you build and run, e.g. the release you checked out (git checkout <release>)
LUMI_VERSION=local

# Image names: lumi-backend/frontend for local builds. For releases with published images, set this to
# ghcr.io/nieve-consulting/lumi and LUMI_VERSION to the release, then docker compose pull api frontend instead of building.
# With a registry prefix the images are never built: if the pull failed, the build Compose falls back to stops with an error
LUMI_IMAGE_PREFIX=lumi

# The address visitors and admins use, without a trailing slash. Also where the widget loads the chat from
LUMI_PUBLIC_URL=https://lumi.example.com

# How the proxy serves it: the domain alone (lumi.example.com) for automatic HTTPS, or :80 for plain HTTP on localhost
# or behind your own TLS-terminating proxy
LUMI_SITE_ADDRESS=lumi.example.com

# Ports the proxy publishes on this host
LUMI_HTTP_PORT=80
LUMI_HTTPS_PORT=443

# Password of the bundled database, used when its volume is first created. Not needed with a database of your own (see
# the external database section below)
POSTGRES_PASSWORD=replace-with-a-random-value

# Secret key of the bundled media storage, which keeps the images admins upload. Not needed with storage of your own (see
# the external media storage section below)
LUMI_STORAGE_SECRET_KEY=replace-with-a-random-value

# Shared secret between the web app and the backend services, at least 32 characters
LUMI_API_KEY=replace-with-a-random-value-of-at-least-32-characters

# OpenAI API key for the assistant, knowledge search, website indexing and writing assistance
OPENAI_API_KEY=sk-replace-me

# Admin sign-in: local (email and password stored by Lumi) or workspace (Google Workspace, see the optional section)
ADMIN_AUTH_PROVIDER=local

# Encrypts admin session cookies. Changing it signs every admin out
NEXTAUTH_SECRET=replace-with-a-random-value

# Needed to complete the onboarding wizard, which creates the first admin: at least 16 characters. Give it only to the
# person setting up the installation. It can be removed once the setup is complete
LUMI_SETUP_TOKEN=replace-with-a-random-value

# Signs the tokens of MCP clients connected to LUMI_PUBLIC_URL/mcp, such as ChatGPT. Changing it disconnects them all
MCP_TOKEN_SECRET=replace-with-a-random-value-of-at-least-32-characters

# ---------------------------------------------------------------------------------------------------------------------
# Optional: leave empty to keep the feature off
# ---------------------------------------------------------------------------------------------------------------------

# Email delivery of enquiries and meeting emails. Without EMAIL_FROM, no email is sent and admins can't add an email
# delivery channel. The SMTP URL includes its credentials, e.g. smtp://user:password@smtp.example.com:587
EMAIL_FROM=
SMTP_URL=

# External database: a PostgreSQL server of your own, with the pgvector extension available, in place of the bundled
# database (PostgreSQL 18). Setting DB_HOST chooses it, and the bundled database is then not started. DB_SSL=true connects
# with TLS and verifies the server's certificate against the publicly trusted authorities. For a server whose authority
# isn't one, such as Amazon RDS or Supabase, set DB_SSL_CA to the authority's certificate file, base64-encoded on one line
# (base64 -w0 global-bundle.pem). DB_SSL_REJECT_UNAUTHORIZED=false skips the verification. Leave them all empty to use the
# bundled database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=

# External media storage: S3-compatible storage of your own (AWS S3, Cloudflare R2, MinIO…) in place of the bundled
# storage. Setting S3_UPLOADS_BUCKET_NAME chooses it, and the bundled storage is then not started. The services reach the
# storage at S3_ENDPOINT; admins' browsers upload to S3_PUBLIC_ENDPOINT (S3_ENDPOINT when empty), whose CORS rules must
# allow PUT from LUMI_PUBLIC_URL. Leave both endpoints empty for AWS S3 itself. Leave them all empty to use the bundled
# storage
S3_UPLOADS_BUCKET_NAME=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# In-chat Google Calendar booking: the service account's JSON key, base64-encoded on one line (base64 -w0 key.json)
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# Google Workspace admin sign-in, with ADMIN_AUTH_PROVIDER=workspace. See https://docs.lumi.nieve.ai/configuration/admin-access.
# The Directory credentials are the service account's JSON key, base64-encoded
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_ALLOWED_DOMAINS=
ADMIN_GOOGLE_GROUP=
GOOGLE_DIRECTORY_CREDENTIALS=
GOOGLE_DIRECTORY_IMPERSONATED_USER=

# MCP server sign-in with Google Workspace (ADMIN_AUTH_PROVIDER=workspace), for its team and write tools. With local,
# admins sign in to it with their Lumi email and password and these stay empty. It also needs ADMIN_ALLOWED_DOMAINS,
# ADMIN_GOOGLE_GROUP, GOOGLE_DIRECTORY_CREDENTIALS and GOOGLE_DIRECTORY_IMPERSONATED_USER above
MCP_GOOGLE_CLIENT_ID=
MCP_GOOGLE_CLIENT_SECRET=
# Group allowed to use the write tools: ADMIN_GOOGLE_GROUP when empty
MCP_WRITE_GOOGLE_GROUP=
# Origins MCP clients may return to after sign-in, comma-separated. Add the clients you use. Empty allows any https one,
# so a client anyone registers could ask an admin to sign in and receive their access
MCP_ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com

# Check for a newer Lumi release, shown in the admin and by the status command: on or off. The server asks GitHub's API
# (api.github.com) for the latest release, about twice a day and on each status run, sending nothing about the installation,
# not even its version. Set off for an installation that must not contact GitHub
LUMI_UPDATE_CHECK=on

# Where the chat links Lumi's source code. Empty links Lumi's own repository. If you run a modified version, the AGPL v3
# asks you to offer its source to the people who use it: set this to where you publish it
LUMI_SOURCE_URL=

# Langfuse tracing of conversations: off unless both keys are set. It sends conversation content to Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=
LANGFUSE_TRACING_ENVIRONMENT=production

# Proxies in front of this installation's proxy whose X-Forwarded-For is trusted, as space-separated CIDR ranges.
# Leave empty unless another proxy or load balancer forwards to this one
LUMI_TRUSTED_PROXIES=

# Public conversation limits, per visitor address unless noted; 0 turns a limit off. Empty keeps the default in brackets.
# See https://docs.lumi.nieve.ai/security#limits
# Chat messages per minute [20]
LUMI_CHAT_TURNS_PER_MINUTE=
# New conversations per minute [10]
LUMI_CHAT_THREADS_PER_MINUTE=
# Bookings and enquiries together per hour [5]
LUMI_HANDOFFS_PER_HOUR=
# Visitor messages in one conversation [50]
LUMI_MAX_MESSAGES_PER_CONVERSATION=
# Model spending per UTC day, in US dollars, for all visitors together, after which the chat is unavailable until the next
# day. Empty for no limit. Set a limit in your OpenAI account as well
LUMI_DAILY_SPEND_LIMIT_USD=

# Weekly cleanup of old conversation checkpoints (Sundays, 03:00 UTC): on or off
CHECKPOINT_CLEANUP_SCHEDULE=on

# Conversation retention: days without activity after which the worker deletes a conversation with its messages, enquiries
# and usage records, daily at 02:30 UTC. Empty keeps conversations until they are deleted in the admin or with the
# delete-conversations command. Deleted conversations stay in your backups until those expire
CONVERSATION_RETENTION_DAYS=
